---
// Google Analytics 4 (gtag.js). Rendered only in production builds with PUBLIC_GA_MEASUREMENT_ID set,
// which is set for Vercel's Production environment only, so dev and preview deploys send nothing.
// Analytics isn't needed to render or use the page, so the loader is fetched at low priority.
// https://docs.astro.build/en/guides/environment-variables/ · https://docs.astro.build/en/reference/directives-reference/#definevars
import { PUBLIC_GA_MEASUREMENT_ID as measurementId } from 'astro:env/client';

const enabled = import.meta.env.PROD && Boolean(measurementId);
---

{enabled && (
	<>
		<script is:inline async fetchpriority='low' src={`https://www.googletagmanager.com/gtag/js?id=${measurementId}`} />
		<script is:inline define:vars={{ measurementId }}>
			window.dataLayer = window.dataLayer || [];
			function gtag() {
				dataLayer.push(arguments);
			}
			gtag('js', new Date());
			gtag('config', measurementId);
		</script>
	</>
)}
