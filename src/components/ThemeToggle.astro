---
// Port of nextra-theme-blog's toggle: sun in light mode, moon in dark (icons swap in CSS, see base.scss).
// Two states, OS setting or its opposite: picking the opposite pins it under localStorage `theme` (the key next-themes
// used, so returning visitors keep their choice); switching back clears it so the site follows the OS again.
---

<button type='button' class='theme-toggle' aria-label='Dark mode' aria-pressed='false'>
	<svg
		class='theme-toggle-sun'
		aria-hidden='true'
		fill='none'
		viewBox='3 3 18 18'
		width='12'
		height='12'
		stroke='currentColor'
	>
		<path
			stroke-linecap='round'
			stroke-linejoin='round'
			stroke-width='2'
			fill='currentColor'
			d='M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z'
		></path>
	</svg>
	<svg
		class='theme-toggle-moon'
		aria-hidden='true'
		fill='none'
		viewBox='2 2 20 20'
		width='12'
		height='12'
		stroke='currentColor'
	>
		<path
			stroke-linecap='round'
			stroke-linejoin='round'
			stroke-width='2'
			fill='currentColor'
			d='M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z'
		></path>
	</svg>
</button>

<script>
	// Initial theme is set before paint by the inline script in Head.astro; this handles changes.
	const root = document.documentElement;
	const meta = document.querySelector<HTMLMetaElement>('meta[name="color-scheme"]')!;
	const osDark = window.matchMedia('(prefers-color-scheme: dark)');
	const buttons = document.querySelectorAll('.theme-toggle');

	type Theme = 'light' | 'dark';
	const systemTheme = (): Theme => (osDark.matches ? 'dark' : 'light');

	function apply(theme: Theme) {
		root.classList.remove('light', 'dark');
		root.classList.add(theme);
		for (const button of buttons) button.setAttribute('aria-pressed', String(theme === 'dark'));
	}

	function pinned(): Theme | null {
		try {
			const theme = localStorage.getItem('theme');
			return theme === 'light' || theme === 'dark' ? theme : null;
		} catch {
			return null;
		}
	}

	function pin(theme: Theme | null) {
		meta.content = theme ?? 'light dark';
		try {
			if (theme) localStorage.setItem('theme', theme);
			else localStorage.removeItem('theme');
		} catch {
			// Storage blocked (private mode): the toggle still works for this page view.
		}
	}

	apply(root.classList.contains('dark') ? 'dark' : 'light');

	for (const button of buttons) {
		button.addEventListener('click', () => {
			const next: Theme = root.classList.contains('dark') ? 'light' : 'dark';
			pin(next === systemTheme() ? null : next);
			apply(next);
		});
	}

	// Follow the OS while the visitor hasn't pinned a theme.
	osDark.addEventListener('change', () => {
		if (!pinned()) apply(systemTheme());
	});
</script>
