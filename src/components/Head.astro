---
// Port of the `Head` in the old theme.config.jsx, with canonical/og:url on `site` (www).
import { pagePath } from '../lib/path';

interface Props {
	title: string;
	description?: string;
	image?: string;
}

const SITE_NAME = 'Victor Foster - UI Engineer';

const { title, description = SITE_NAME, image } = Astro.props;
const canonicalUrl = new URL(pagePath(Astro.url), Astro.site).href;
const ogImage = image ? new URL(image, Astro.site).href : new URL('/og-image.png', Astro.site).href;
---

<meta charset='utf-8' />
<meta name='viewport' content='width=device-width' />
<title>{title}</title>
<meta name='description' content={description} />
<link rel='canonical' href={canonicalUrl} />
<link rel='alternate' type='application/rss+xml' title='RSS' href='/feed.xml' />

<meta property='og:type' content='website' />
<meta property='og:url' content={canonicalUrl} />
<meta property='og:title' content={title} />
<meta property='og:description' content={description} />
<meta property='og:site_name' content={SITE_NAME} />
<meta property='og:image' content={ogImage} />
<meta property='og:image:width' content='1200' />
<meta property='og:image:height' content='630' />
<meta property='og:image:alt' content={title} />

<meta name='twitter:card' content='summary_large_image' />
<meta name='twitter:title' content={title} />
<meta name='twitter:description' content={description} />
<meta name='twitter:image' content={ogImage} />
<meta name='twitter:image:alt' content={title} />

<link rel='preconnect' href='https://fonts.googleapis.com' />
<link rel='preconnect' href='https://fonts.gstatic.com' crossorigin />
<link
	href='https://fonts.googleapis.com/css2?family=Open+Sans&family=Vollkorn:wght@400;600&display=swap'
	rel='stylesheet'
/>
