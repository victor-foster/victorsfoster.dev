---
// Port of the `Head` in the old theme.config.jsx, with canonical/og:url on `site` (www).
import { Font } from 'astro:assets';
import Analytics from './Analytics.astro';
import { pagePath } from '../lib/path';

interface Props {
	title: string;
	description?: string;
	image?: string;
}

const SITE_NAME = 'Victor Foster - UI Engineer';

const { title, image } = Astro.props;
const description = Astro.props.description || SITE_NAME;
const canonicalUrl = new URL(pagePath(Astro.url), Astro.site).href;
const ogImage = image ? new URL(image, Astro.site).href : new URL('/og-image.png', Astro.site).href;
---

<meta charset='utf-8' />
<meta name='viewport' content='width=device-width' />
<!--
	Set the theme before first paint (no flash), with the same logic and localStorage key as the next-themes script
	production used: stored 'light' | 'dark' wins, otherwise follow the OS. is:inline keeps it render-blocking and unbundled.
	https://docs.astro.build/en/guides/client-side-scripts/
-->
<script is:inline>
	(function () {
		var root = document.documentElement;
		try {
			var theme = localStorage.getItem('theme');
			if (theme !== 'light' && theme !== 'dark') {
				theme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
			}
			root.classList.add(theme);
			root.style.colorScheme = theme;
		} catch (e) {}
	})();
</script>
<title>{title}</title>
<meta name='description' content={description} />
<link rel='canonical' href={canonicalUrl} />
<link rel='alternate' type='application/rss+xml' title='RSS' href='/feed.xml' />

<meta property='og:type' content='website' />
<meta property='og:url' content={canonicalUrl} />
<meta property='og:title' content={title} />
<meta property='og:description' content={description} />
<meta property='og:site_name' content={SITE_NAME} />
<meta property='og:image' content={ogImage} />
<meta property='og:image:width' content='1200' />
<meta property='og:image:height' content='630' />
<meta property='og:image:alt' content={title} />

<meta name='twitter:card' content='summary_large_image' />
<meta name='twitter:title' content={title} />
<meta name='twitter:description' content={description} />
<meta name='twitter:image' content={ogImage} />
<meta name='twitter:image:alt' content={title} />

<Font cssVariable='--font-open-sans' preload />
<Font cssVariable='--font-vollkorn' preload />
<Analytics />
