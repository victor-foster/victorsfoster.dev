---
// Used directly by .astro pages (props) and by MDX pages via `layout:` frontmatter (`frontmatter` prop).
// https://docs.astro.build/en/basics/layouts/#markdown-layouts
import 'sanitize.css';
import '../styles/main.scss';
import Head from '../components/Head.astro';
import Nav from '../components/Nav.astro';

interface Props {
	title: string;
	description?: string;
	summary?: string;
	image?: string;
	frontmatter?: Omit<Props, 'frontmatter'>;
}

const { title, description, summary, image } = Astro.props.frontmatter ?? Astro.props;
---

<html lang='en'>
	<head>
		<Head title={title} description={description || summary} image={image} />
	</head>
	<body>
		<article class='page'>
			<h1>{title}</h1>
			<div class='page-header'>
				<Nav />
			</div>
			<slot />
			<footer></footer>
		</article>
	</body>
</html>
